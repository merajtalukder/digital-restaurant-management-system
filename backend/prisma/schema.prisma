generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int        @id @default(autoincrement())
  name      String
  email     String     @unique(map: "User_email_key")
  password  String
  phone     String?
  role      UserRole   @default(WAITER)
  status    UserStatus @default(ACTIVE)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  orders    Order[]

  @@map("user")
}

model Category {
  id          Int        @id @default(autoincrement())
  name        String     @unique(map: "Category_name_key")
  description String?
  status      Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  menuItems   MenuItem[]

  @@map("category")
}

model MenuItem {
  id          Int         @id @default(autoincrement())
  name        String
  description String?
  price       Decimal     @db.Decimal(10, 2)
  image       String?
  foodType    FoodType
  isAvailable Boolean     @default(true)
  categoryId  Int
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  category    Category    @relation(fields: [categoryId], references: [id], map: "MenuItem_categoryId_fkey")
  orderItems  OrderItem[]

  @@index([categoryId], map: "MenuItem_categoryId_fkey")
  @@map("menuitem")
}

model RestaurantTable {
  id          Int         @id @default(autoincrement())
  tableNumber Int         @unique(map: "RestaurantTable_tableNumber_key")
  capacity    Int
  status      TableStatus @default(AVAILABLE)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  orders      Order[]

  @@map("restauranttable")
}

model Order {
  id           Int             @id @default(autoincrement())
  orderNumber  String          @unique(map: "Order_orderNumber_key")
  customerName String?
  orderType    OrderType
  status       OrderStatus     @default(PENDING)
  totalAmount  Decimal         @db.Decimal(10, 2)
  tableId      Int
  waiterId     Int?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  table        RestaurantTable @relation(fields: [tableId], references: [id], map: "Order_tableId_fkey")
  waiter       User?           @relation(fields: [waiterId], references: [id], map: "Order_waiterId_fkey")
  orderItems   OrderItem[]
  payment      Payment?

  @@index([tableId], map: "Order_tableId_fkey")
  @@index([waiterId], map: "Order_waiterId_fkey")
  @@map("order")
}

model OrderItem {
  id                  Int      @id @default(autoincrement())
  quantity            Int
  unitPrice           Decimal  @db.Decimal(10, 2)
  subtotal            Decimal  @db.Decimal(10, 2)
  orderId             Int
  menuItemId          Int
  specialInstructions String?  @db.Text
  menuItem            MenuItem @relation(fields: [menuItemId], references: [id], map: "OrderItem_menuItemId_fkey")
  order               Order    @relation(fields: [orderId], references: [id], map: "OrderItem_orderId_fkey")

  @@index([menuItemId], map: "OrderItem_menuItemId_fkey")
  @@index([orderId], map: "OrderItem_orderId_fkey")
  @@map("orderitem")
}

model Payment {
  id            Int           @id @default(autoincrement())
  method        PaymentMethod
  status        PaymentStatus @default(PENDING)
  amount        Decimal       @db.Decimal(10, 2)
  transactionId String?
  orderId       Int           @unique(map: "Payment_orderId_key")
  createdAt     DateTime      @default(now())
  order         Order         @relation(fields: [orderId], references: [id], map: "Payment_orderId_fkey")

  @@map("payment")
}

enum UserRole {
  ADMIN
  MANAGER
  WAITER
  CASHIER
  KITCHEN
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum FoodType {
  INSTANT
  COOKED
}

enum TableStatus {
  AVAILABLE
  OCCUPIED
  RESERVED
}

enum OrderType {
  WAITER
  QR
}

enum OrderStatus {
  PENDING
  PREPARING
  READY
  SERVED
  COMPLETED
  CANCELLED
}

enum PaymentMethod {
  CASH
  CARD
  BKASH
  NAGAD
  ROCKET
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}
