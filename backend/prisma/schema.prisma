generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Category {
  id          Int        @id @default(autoincrement())
  name        String     @unique
  description String?
  status      Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  menuItems   MenuItem[]

  @@map("Category")
}

model MenuItem {
  id          Int        @id @default(autoincrement())
  name        String
  description String?
  price       Decimal    @db.Decimal(10, 2)
  image       String?
  foodType    FoodType
  isAvailable Boolean    @default(true)
  categoryId  Int
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  category    Category   @relation(fields: [categoryId], references: [id])
  orderItems  OrderItem[]

  @@index([categoryId], map: "MenuItem_categoryId_fkey")
  @@map("MenuItem")
}

model Order {
  id              Int             @id @default(autoincrement())
  orderNumber     String          @unique
  customerName    String?
  orderType       OrderType
  status          OrderStatus     @default(PENDING)
  totalAmount     Decimal         @db.Decimal(10, 2)
  tableId         Int
  waiterId        Int?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  table           RestaurantTable @relation(fields: [tableId], references: [id])
  waiter          User?           @relation(fields: [waiterId], references: [id])
  orderItems      OrderItem[]
  payment         Payment?

  @@index([tableId], map: "Order_tableId_fkey")
  @@index([waiterId], map: "Order_waiterId_fkey")
  @@map("Order")
}

model OrderItem {
  id         Int      @id @default(autoincrement())
  quantity   Int
  unitPrice  Decimal  @db.Decimal(10, 2)
  subtotal   Decimal  @db.Decimal(10, 2)
  orderId    Int
  menuItemId Int

  menuItem   MenuItem @relation(fields: [menuItemId], references: [id])
  order      Order    @relation(fields: [orderId], references: [id])

  @@index([menuItemId], map: "OrderItem_menuItemId_fkey")
  @@index([orderId], map: "OrderItem_orderId_fkey")
  @@map("OrderItem")
}

model Payment {
  id            Int           @id @default(autoincrement())
  method        PaymentMethod
  status        PaymentStatus @default(PENDING)
  amount        Decimal       @db.Decimal(10, 2)
  transactionId String?
  orderId       Int           @unique
  createdAt     DateTime      @default(now())

  order         Order         @relation(fields: [orderId], references: [id])

  @@map("Payment")
}

model RestaurantTable {
  id          Int          @id @default(autoincrement())
  tableNumber Int          @unique
  capacity    Int
  status      TableStatus   @default(AVAILABLE)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime      @updatedAt

  orders      Order[]

  @@map("RestaurantTable")
}

model User {
  id        Int        @id @default(autoincrement())
  name      String
  email     String     @unique
  password  String
  phone     String?
  role      UserRole   @default(WAITER)
  status    UserStatus @default(ACTIVE)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  orders    Order[]

  @@map("User")
}

enum PaymentMethod {
  CASH
  CARD
  BKASH
  NAGAD
  ROCKET
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum TableStatus {
  AVAILABLE
  OCCUPIED
  RESERVED
}

enum OrderType {
  WAITER
  QR
}

enum OrderStatus {
  PENDING
  PREPARING
  READY
  SERVED
  COMPLETED
  CANCELLED
}

enum UserRole {
  ADMIN
  MANAGER
  WAITER
  CASHIER
  KITCHEN
}

enum FoodType {
  INSTANT
  COOKED
}

enum UserStatus {
  ACTIVE
  INACTIVE
}